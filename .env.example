# ==============================================================================
# ApplyVise AI — Production & Development Environment Configuration
# ==============================================================================

# Application Port (Defaults to 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Gemini AI API Key (Required for AI Profile Extraction & Tailoring)
# Obtain at: https://aistudio.google.com/
GEMINI_API_KEY=""

# Public Application Base URL
APP_URL="http://localhost:3000"

# Production PostgreSQL Database URL (Optional: Defaults to embedded relational SQLite)
# Example: postgresql://postgres:password@localhost:5432/applywise
DATABASE_URL=""

# Session / JWT Secret Key for token signature verification
SESSION_SECRET="applywise_super_secure_random_key_production_2026"

# Rate Limit Window & Limits (Optional)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# AI HR Outreach & Email OAuth Integration (Optional — Sending remains disabled until provided)
EMAIL_ENCRYPTION_KEY=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
