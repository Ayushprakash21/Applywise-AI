{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "applywise-ai",
  "account_id": "dd579baef921a84503c3989aa829d7d3",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "applywise-db",
      "database_id": "36c07326-65a2-44cf-8f38-4df1a7103cd5"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
